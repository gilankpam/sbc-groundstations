diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
index c3dcd93..b081fed 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
@@ -720,4 +720,95 @@
 #define VE_AVC_REC_SLUMA		0xbbc
 #define VE_AVC_MB_INFO			0xbc0
 
+/*
+ * H.264 encoder (ISP input stage at 0xa00, AVC encoder at 0xb00).
+ *
+ * Layout after Bootlin's V3s encoder. On the H616 VE the encoder-block
+ * address registers take the bus address >> 8 (VE_ENC_ADDR), while the ISP
+ * input addresses stay plain bus addresses, and VE_ISP_SCALER_SIZE counts in
+ * half macroblocks and sets the encoder's macroblock grid.
+ */
+
+#define VE_RESET_REG				0x04
+#define VE_RESET_ENCODER_RESET			BIT(24)
+#define VE_RESET_SYNC_IDLE			BIT(9)
+#define VE_RESET_CACHE_SYNC_IDLE		BIT(8)
+
+#define VE_MODE_ENC_ENABLE			BIT(7)
+#define VE_MODE_ENC_ISP_ENABLE			BIT(6)
+
+#define VE_ENC_ADDR(a)				((u32)((a) >> 8))
+
+#define VE_ISP_PIC_INFO_REG			0xa00
+#define VE_ISP_PIC_INFO_WIDTH_MBS(v)		SHIFT_AND_MASK_BITS(v, 31, 16)
+#define VE_ISP_PIC_INFO_HEIGHT_MBS(v)		SHIFT_AND_MASK_BITS(v, 15, 0)
+#define VE_ISP_PIC_STRIDE0_REG			0xa04
+#define VE_ISP_PIC_STRIDE0_INPUT_STRIDE_MBS(v)	SHIFT_AND_MASK_BITS(v, 26, 16)
+#define VE_ISP_CTRL_REG				0xa08
+#define VE_ISP_CTRL_FORMAT_YUV420SP		(0 << 27)
+#define VE_ISP_SCALER_SIZE_REG			0xa2c
+#define VE_ISP_SCALER_SIZE_HEIGHT(v)		SHIFT_AND_MASK_BITS(v, 26, 16)
+#define VE_ISP_SCALER_SIZE_WIDTH(v)		SHIFT_AND_MASK_BITS(v, 10, 0)
+#define VE_ISP_INPUT_LUMA_ADDR_REG		0xa78
+#define VE_ISP_INPUT_CHROMA0_ADDR_REG		0xa7c
+
+#define VE_ENC_AVC_PARA0_REG			0xb04
+#define VE_ENC_AVC_PARA0_EPTB_DIS		BIT(31)
+#define VE_ENC_AVC_PARA0_ENTROPY_CODING_CABAC	BIT(8)
+#define VE_ENC_AVC_PARA0_SLICE_TYPE_I		(0 << 4)
+#define VE_ENC_AVC_PARA0_SLICE_TYPE_P		(1 << 4)
+#define VE_ENC_AVC_PARA1_REG			0xb08
+#define VE_ENC_AVC_PARA1_QP_CHROMA_OFFSET0(v)	SHIFT_AND_MASK_BITS(v, 18, 16)
