+	.vidioc_create_bufs		= v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf			= v4l2_m2m_ioctl_expbuf,
+
+	.vidioc_streamon		= v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff		= v4l2_m2m_ioctl_streamoff,
+
+	.vidioc_try_encoder_cmd		= v4l2_m2m_ioctl_try_encoder_cmd,
+	.vidioc_encoder_cmd		= v4l2_m2m_ioctl_encoder_cmd,
+
+	.vidioc_subscribe_event		= cedrus_enc_subscribe_event,
+	.vidioc_unsubscribe_event	= v4l2_event_unsubscribe,
+};
+
+/* Queues */
+
+static int cedrus_enc_queue_setup(struct vb2_queue *vq, unsigned int *nbufs,
+				  unsigned int *nplanes, unsigned int sizes[],
+				  struct device *alloc_devs[])
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_pix_format *pix = V4L2_TYPE_IS_OUTPUT(vq->type) ?
+				      &ctx->src_fmt : &ctx->dst_fmt;
+
+	if (*nplanes) {
+		if (sizes[0] < pix->sizeimage)
+			return -EINVAL;
+	} else {
+		sizes[0] = pix->sizeimage;
+		*nplanes = 1;
+	}
+
+	return 0;
+}
+
+static int cedrus_enc_buf_out_validate(struct vb2_buffer *vb)
+{
+	to_vb2_v4l2_buffer(vb)->field = V4L2_FIELD_NONE;
+	return 0;
+}
+
+static int cedrus_enc_buf_prepare(struct vb2_buffer *vb)
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct v4l2_pix_format *pix = V4L2_TYPE_IS_OUTPUT(vb->vb2_queue->type) ?
+				      &ctx->src_fmt : &ctx->dst_fmt;
+	dma_addr_t addr = vb2_dma_contig_plane_dma_addr(vb, 0);
+
+	if (vb2_plane_size(vb, 0) < pix->sizeimage)
+		return -EINVAL;
+
+	/* The encoder block addresses its buffers in 256-byte units. */
+	if (V4L2_TYPE_IS_CAPTURE(vb->vb2_queue->type) && (addr & 0xff))
+		return -EINVAL;
+
+	return 0;
+}
+
+static void cedrus_enc_buf_queue(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	if (V4L2_TYPE_IS_CAPTURE(vb->vb2_queue->type) &&
+	    v4l2_m2m_dst_buf_is_last(ctx->fh.m2m_ctx)) {
+		vb2_set_plane_payload(vb, 0, 0);
+		v4l2_m2m_last_buffer_done(ctx->fh.m2m_ctx, vbuf);
+		return;
+	}
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, vbuf);
+}
+
+static void cedrus_enc_queue_cleanup(struct vb2_queue *vq, u32 state)
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		if (V4L2_TYPE_IS_OUTPUT(vq->type))
+			vbuf = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+		else
+			vbuf = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+
+		if (!vbuf)
+			return;
+
+		v4l2_m2m_buf_done(vbuf, state);
+	}
+}
+
+static int cedrus_enc_start_streaming(struct vb2_queue *vq,
+				      unsigned int count)
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct cedrus_enc_ctx *enc = ctx->enc;
+	int ret;
+
+	v4l2_m2m_update_start_streaming_state(ctx->fh.m2m_ctx, vq);
+
+	if (!V4L2_TYPE_IS_OUTPUT(vq->type))
+		return 0;
+
+	enc->width_mbs = DIV_ROUND_UP(ctx->src_fmt.width, 16);
+	enc->height_mbs = DIV_ROUND_UP(ctx->src_fmt.height, 16);
+	enc->cur = 0;
+	enc->have_ref = false;
+	enc->gop_index = 0;
+	enc->sps_pps_sent = false;
+	enc->force_key = false;
+
+	ret = cedrus_enc_buffers_alloc(ctx);
+	if (ret)
+		goto err_cleanup;
+
+	ret = pm_runtime_resume_and_get(ctx->dev->dev);
+	if (ret < 0)
+		goto err_free;
+
+	return 0;
+
+err_free:
+	cedrus_enc_buffers_free(ctx);
+err_cleanup:
+	cedrus_enc_queue_cleanup(vq, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void cedrus_enc_stop_streaming(struct vb2_queue *vq)
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+
+	cedrus_enc_queue_cleanup(vq, VB2_BUF_STATE_ERROR);
+
+	v4l2_m2m_update_stop_streaming_state(ctx->fh.m2m_ctx, vq);
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type)) {
+		pm_runtime_put(ctx->dev->dev);
+		cedrus_enc_buffers_free(ctx);
+	}
+}
+
+static const struct vb2_ops cedrus_enc_qops = {
+	.queue_setup		= cedrus_enc_queue_setup,
+	.buf_out_validate	= cedrus_enc_buf_out_validate,
+	.buf_prepare		= cedrus_enc_buf_prepare,
+	.buf_queue		= cedrus_enc_buf_queue,
+	.start_streaming	= cedrus_enc_start_streaming,
+	.stop_streaming		= cedrus_enc_stop_streaming,
+};
+
+static int cedrus_enc_queue_init(void *priv, struct vb2_queue *src_vq,
+				 struct vb2_queue *dst_vq)
+{
+	struct cedrus_ctx *ctx = priv;
+	int ret;
+
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->drv_priv = ctx;
+	src_vq->buf_struct_size = sizeof(struct cedrus_buffer);
+	src_vq->ops = &cedrus_enc_qops;
+	src_vq->mem_ops = &vb2_dma_contig_memops;
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &ctx->dev->dev_mutex;
+	src_vq->dev = ctx->dev->dev;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->drv_priv = ctx;
+	dst_vq->buf_struct_size = sizeof(struct cedrus_buffer);
+	dst_vq->ops = &cedrus_enc_qops;
+	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &ctx->dev->dev_mutex;
+	dst_vq->dev = ctx->dev->dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/* Controls */
+
+static int cedrus_enc_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cedrus_ctx *ctx = container_of(ctrl->handler, struct cedrus_ctx,
+					      hdl);
+
+	switch (ctrl->id) {
+	case V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:
+		ctx->enc->force_key = true;
+		break;
+	}
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops cedrus_enc_ctrl_ops = {
+	.s_ctrl = cedrus_enc_s_ctrl,
+};
+
+static int cedrus_enc_init_ctrls(struct cedrus_ctx *ctx)
+{
+	const struct v4l2_ctrl_ops *ops = &cedrus_enc_ctrl_ops;
+	struct v4l2_ctrl_handler *hdl = &ctx->hdl;
+	struct cedrus_enc_ctx *enc = ctx->enc;
+
+	v4l2_ctrl_handler_init(hdl, 16);
+
+	enc->ctrl_profile = v4l2_ctrl_new_std_menu(hdl, ops,
+		V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+		V4L2_MPEG_VIDEO_H264_PROFILE_MAIN,
+		~(BIT(V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE) |
+		  BIT(V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE) |
+		  BIT(V4L2_MPEG_VIDEO_H264_PROFILE_MAIN)),
+		V4L2_MPEG_VIDEO_H264_PROFILE_MAIN);
+	enc->ctrl_level = v4l2_ctrl_new_std_menu(hdl, ops,
+		V4L2_CID_MPEG_VIDEO_H264_LEVEL,
+		V4L2_MPEG_VIDEO_H264_LEVEL_5_1, 0,
+		V4L2_MPEG_VIDEO_H264_LEVEL_4_2);
+	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_H264_ENTROPY_MODE,
+		V4L2_MPEG_VIDEO_H264_ENTROPY_MODE_CAVLC,
+		~BIT(V4L2_MPEG_VIDEO_H264_ENTROPY_MODE_CAVLC),
+		V4L2_MPEG_VIDEO_H264_ENTROPY_MODE_CAVLC);
+	enc->ctrl_qp_i = v4l2_ctrl_new_std(hdl, ops,
+		V4L2_CID_MPEG_VIDEO_H264_I_FRAME_QP, 0, 51, 1, 26);
+	enc->ctrl_qp_p = v4l2_ctrl_new_std(hdl, ops,
+		V4L2_CID_MPEG_VIDEO_H264_P_FRAME_QP, 0, 51, 1, 28);
+	enc->ctrl_qp_min = v4l2_ctrl_new_std(hdl, ops,
+		V4L2_CID_MPEG_VIDEO_H264_MIN_QP, 0, 51, 1, 0);
+	enc->ctrl_qp_max = v4l2_ctrl_new_std(hdl, ops,
+		V4L2_CID_MPEG_VIDEO_H264_MAX_QP, 0, 51, 1, 51);
+	enc->ctrl_gop = v4l2_ctrl_new_std(hdl, ops,
+		V4L2_CID_MPEG_VIDEO_GOP_SIZE, 1, 1024, 1, 60);
+	enc->ctrl_prepend = v4l2_ctrl_new_std(hdl, ops,
+		V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR, 0, 1, 1, 1);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME,
+			  0, 0, 0, 0);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_B_FRAMES, 0, 0, 1, 0);
+	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_HEADER_MODE,
+		V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME,
+		~BIT(V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME),
+		V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME);
+	/*
+	 * Fixed QP only. Bitrate and frame-level rate control are accepted so
+	 * generic clients configure cleanly; they do not change the output.
+	 */
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_BITRATE,
+			  1, 100000000, 1, 8000000);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE,
+			  0, 1, 1, 0);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MIN_BUFFERS_FOR_OUTPUT,
+			  1, 32, 1, 1);
+
+	if (hdl->error) {
+		int ret = hdl->error;
+
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	ctx->fh.ctrl_handler = hdl;
+	return v4l2_ctrl_handler_setup(hdl);
+}
+
+/* File operations */
+
+static int cedrus_enc_open(struct file *file)
+{
+	struct cedrus_dev *dev = video_drvdata(file);
+	struct cedrus_ctx *ctx;
+	int ret;
+
+	if (mutex_lock_interruptible(&dev->dev_mutex))
+		return -ERESTARTSYS;
+
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx) {
+		ret = -ENOMEM;
+		goto err_unlock;
+	}
+
+	ctx->enc = kzalloc(sizeof(*ctx->enc), GFP_KERNEL);
+	if (!ctx->enc) {
+		ret = -ENOMEM;
+		goto err_free_ctx;
+	}
+
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+	ctx->dev = dev;
+	ctx->bit_depth = 8;
+	ctx->current_codec = &cedrus_enc_ops_h264;
+	ctx->enc->timeperframe = (struct v4l2_fract){ 1, 30 };
+
+	ctx->src_fmt.width = 1280;
+	ctx->src_fmt.height = 720;
+	cedrus_enc_prepare_src_fmt(&ctx->src_fmt);
+	ctx->src_fmt.colorspace = V4L2_COLORSPACE_REC709;
+	cedrus_enc_prepare_dst_fmt(ctx, &ctx->dst_fmt);
+
+	ret = cedrus_enc_init_ctrls(ctx);
+	if (ret)
+		goto err_free_enc;
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(dev->m2m_dev, ctx,
+					    &cedrus_enc_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto err_free_ctrls;
+	}
+
+	v4l2_fh_add(&ctx->fh, file);
+	mutex_unlock(&dev->dev_mutex);
+
+	return 0;
+
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&ctx->hdl);
+err_free_enc:
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx->enc);
+err_free_ctx:
+	kfree(ctx);
+err_unlock:
+	mutex_unlock(&dev->dev_mutex);
+	return ret;
+}
+
+static int cedrus_enc_release(struct file *file)
+{
+	struct cedrus_dev *dev = video_drvdata(file);
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	mutex_lock(&dev->dev_mutex);
+
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	v4l2_ctrl_handler_free(&ctx->hdl);
+	v4l2_fh_exit(&ctx->fh);
+	cedrus_enc_buffers_free(ctx);
+	kfree(ctx->enc);
+	kfree(ctx);
+
+	mutex_unlock(&dev->dev_mutex);
+
+	return 0;
+}
+
+static const struct v4l2_file_operations cedrus_enc_fops = {
+	.owner		= THIS_MODULE,
+	.open		= cedrus_enc_open,
+	.release	= cedrus_enc_release,
+	.poll		= v4l2_m2m_fop_poll,
+	.unlocked_ioctl	= video_ioctl2,
+	.mmap		= v4l2_m2m_fop_mmap,
+};
+
+const struct video_device cedrus_enc_video_device = {
+	.name		= CEDRUS_NAME "-enc",
+	.vfl_dir	= VFL_DIR_M2M,
+	.fops		= &cedrus_enc_fops,
+	.ioctl_ops	= &cedrus_enc_ioctl_ops,
+	.minor		= -1,
+	.release	= video_device_release_empty,
+	.device_caps	= V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING,
+};
