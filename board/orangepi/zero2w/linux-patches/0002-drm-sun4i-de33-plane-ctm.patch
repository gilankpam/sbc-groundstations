+/*
+ * A colour matrix on the plane (the "CTM" property, sun8i_vi_layer.c),
+ * folded into the DE33 CCSC. The CCSC computes, per output channel r,
+ *   out_r = sum_c C[r][c] * (in_c - d_c) + k_r
+ * in 10-bit units, C in S2.17, the pre-offsets d subtracted. A CTM
+ * [A | b] on normalised RGB composes as C' = A.C plus an output offset
+ * o = A.k + b * DE33_CSC_ONE. The post-constants k cannot carry a negative
+ * offset (measured on an H618: the picture saturates), so o goes into the
+ * luma pre-offset instead: raising d_Y by D shifts every row by
+ * -C'[r][Y] * D. That holds o exactly only when o is along C'[.][Y] -- a
+ * grey shift for a matrix that keeps grey grey, which is what a colour
+ * grade's lift/offset is. Any other offset, a d_Y outside the field, or a
+ * coefficient of 4.0 or more (signed 20-bit, wraps) is refused. Register
+ * limits: mabur docs/findings/2026-10-12-opi-colortrans-probe.md.
+ */
+#define DE33_CSC_ONE		1024		/* 1.0 in the CCSC's 10-bit RGB */
+#define DE33_CSC_COEF_MAX	((4 << 17) - 1)	/* largest |coefficient|, S2.17 */
+#define DE33_CSC_PREOFF_MAX	1023		/* 10-bit pre-offset field */
+#define DE33_CSC_OFFSET_TOL	2		/* per-row offset error, 10-bit units */
+#define DE33_CTM_MAX		(8LL << 32)	/* |A|,|b| bound: keeps s64 products exact */
+
+static s64 sun8i_ctm_s31_32(u64 v)
+{
+	s64 mag = (s64)(v & ~BIT_ULL(63));
+
+	return (v & BIT_ULL(63)) ? -mag : mag;
+}
+
+/* stock/out: the 15-word DE33 layout of sun8i_de33_convert_table(). */
+int sun8i_de33_csc_apply_ctm(const u32 *stock,
+			     const struct sun8i_ctm_3x4 *ctm, u32 *out)
+{
+	s64 a[3][4], o[3], cy[3], num, den, dy, res;
+	int r, c, j, best = 0;
+
+	for (r = 0; r < 3; r++)
+		for (c = 0; c < 4; c++) {
+			a[r][c] = sun8i_ctm_s31_32(ctm->matrix[r * 4 + c]);
+			if (a[r][c] > DE33_CTM_MAX || a[r][c] < -DE33_CTM_MAX)
+				return -ERANGE;
+		}
+
+	memcpy(out, stock, 15 * sizeof(u32));
+	for (r = 0; r < 3; r++) {
+		/* o_r in 10-bit units, S.32; the stock post-constants are 0. */
+		o[r] = a[r][3] * DE33_CSC_ONE;
+		for (c = 0; c < 3; c++) {
+			s64 v = 0;
+
+			for (j = 0; j < 3; j++)
+				v += a[r][j] * (s32)stock[3 + 4 * j + c];
+			v = (v + (1LL << 31)) >> 32;
+			if (v > DE33_CSC_COEF_MAX || v < -DE33_CSC_COEF_MAX)
+				return -ERANGE;
+			out[3 + 4 * r + c] = (u32)(s32)v;
+		}
+		cy[r] = (s32)out[3 + 4 * r];	/* C'[r][Y], S2.17 */
+		if (abs(cy[r]) > abs(cy[best]))
+			best = r;
+	}
+
+	/* D = -o / C'[.][Y], from the row with the largest luma gain. */
+	dy = 0;
+	if (o[0] || o[1] || o[2]) {
+		if (!cy[best])
+			return -ERANGE;
+		num = -o[best];
+		den = cy[best] << 15;		/* S.32 / S.17 -> 10-bit units */
+		dy = div64_s64(num + (((num < 0) ^ (den < 0)) ? -den / 2 : den / 2),
+			       den);
+	}
+	for (r = 0; r < 3; r++) {
+		res = o[r] + cy[r] * dy * (1LL << 15);
+		if (res > ((s64)DE33_CSC_OFFSET_TOL << 32) ||
+		    res < -((s64)DE33_CSC_OFFSET_TOL << 32))
+			return -ERANGE;
+	}
+	dy += stock[0];
+	if (dy < 0 || dy > DE33_CSC_PREOFF_MAX)
+		return -ERANGE;
+	out[0] = (u32)dy;
+	return 0;
+}
