+struct sun8i_vi_layer_state {
+	struct drm_plane_state base;
+	struct drm_property_blob *ctm;
+};
+
+static struct sun8i_vi_layer_state *to_sun8i_vi_state(struct drm_plane_state *s)
+{
+	return container_of(s, struct sun8i_vi_layer_state, base);
+}
+
+const struct sun8i_ctm_3x4 *
+sun8i_vi_layer_state_ctm(const struct drm_plane_state *state)
+{
+	const struct sun8i_vi_layer_state *s =
+		container_of(state, struct sun8i_vi_layer_state, base);
+
+	return s->ctm ? s->ctm->data : NULL;
+}
+
+static void sun8i_vi_layer_reset(struct drm_plane *plane)
+{
+	struct sun8i_vi_layer_state *s;
+
+	if (plane->state) {
+		plane->funcs->atomic_destroy_state(plane, plane->state);
+		plane->state = NULL;
+	}
+	s = kzalloc(sizeof(*s), GFP_KERNEL);
+	if (s)
+		__drm_atomic_helper_plane_reset(plane, &s->base);
+}
+
+static struct drm_plane_state *
+sun8i_vi_layer_duplicate_state(struct drm_plane *plane)
+{
+	struct sun8i_vi_layer_state *old = to_sun8i_vi_state(plane->state);
+	struct sun8i_vi_layer_state *s;
+
+	s = kmalloc(sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return NULL;
+	__drm_atomic_helper_plane_duplicate_state(plane, &s->base);
+	s->ctm = old->ctm;
+	if (s->ctm)
+		drm_property_blob_get(s->ctm);
+	return &s->base;
+}
+
+static void sun8i_vi_layer_destroy_state(struct drm_plane *plane,
+					 struct drm_plane_state *state)
+{
+	struct sun8i_vi_layer_state *s = to_sun8i_vi_state(state);
+
+	drm_property_blob_put(s->ctm);
+	__drm_atomic_helper_plane_destroy_state(state);
+	kfree(s);
+}
+
+static int sun8i_vi_layer_set_property(struct drm_plane *plane,
+				       struct drm_plane_state *state,
+				       struct drm_property *property,
+				       u64 val)
+{
+	struct sun8i_layer *layer = plane_to_sun8i_layer(plane);
+	bool replaced = false;
+
+	if (!layer->ctm_prop || property != layer->ctm_prop)
+		return -EINVAL;
+	return drm_property_replace_blob_from_id(plane->dev,
+						 &to_sun8i_vi_state(state)->ctm,
+						 val, sizeof(struct sun8i_ctm_3x4),
+						 -1, &replaced);
+}
+
+static int sun8i_vi_layer_get_property(struct drm_plane *plane,
+				       const struct drm_plane_state *state,
+				       struct drm_property *property,
+				       u64 *val)
+{
+	struct sun8i_layer *layer = plane_to_sun8i_layer(plane);
+	const struct sun8i_vi_layer_state *s =
+		container_of(state, struct sun8i_vi_layer_state, base);
+
+	if (!layer->ctm_prop || property != layer->ctm_prop)
+		return -EINVAL;
+	*val = s->ctm ? s->ctm->base.id : 0;
+	return 0;
+}
