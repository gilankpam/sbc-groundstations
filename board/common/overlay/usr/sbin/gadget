#!/bin/sh
# Credits to zhouruixi
# see: https://github.com/zhouruixi/SBC-GS/blob/main/gs/otg-gadget.sh

sed -i '/^ttyGS0/d' /etc/inittab
kill -HUP 1
if [ x$1 = "xinit" -a ! -f /tmp/gadget ] ; then
	exit 0
fi

# What gadget mode shuts down: all of it records to DVR or writes to /config,
# and the PC owns both while the gadget exists.
GADGET_STOP_SERVICES="S98gsweb S97maburplay S96maburgs"
GADGET_START_SERVICES="S96maburgs S97maburplay S98gsweb"

# gsweb runs under python3, so pidof cannot find it by name.
service_pids() {
	pidof maburplay maburgs
	ps | awk '$NF=="/usr/bin/gsweb.py"{print $1}'
}

stop_services() {
	for s in $GADGET_STOP_SERVICES; do
		[ -x /etc/init.d/$s ] && /etc/init.d/$s stop
	done
	# The stop scripts only signal: give the daemons time to save and exit,
	# since a late write would land on a filesystem the PC now owns.
	for i in 1 2 3 4 5; do
		[ -z "$(service_pids)" ] && return
		sleep 1
	done
	kill -9 $(service_pids) 2>/dev/null
	sleep 1
}

# debugfs
[ ! -e /sys/kernel/debug/usb/fcc00000.usb/mode ] && mount -t debugfs none /sys/kernel/debug
# 挂载ConfigFS
grep -q "/sys/kernel/config configfs" /proc/mounts || mount -t configfs none /sys/kernel/config

# 切换OTG端口为device模式
if [ "$(cat /sys/kernel/debug/usb/fcc00000.usb/mode)" == "host" ]; then
	echo device > /sys/kernel/debug/usb/fcc00000.usb/mode || exit 1
	sleep 0.5
fi

# 加载 libcomposite 模块
[ -d /sys/kernel/config/usb_gadget ] || modprobe libcomposite

# 若存在 gadget g1 则先删除
if [ -d /sys/kernel/config/usb_gadget/g1 ]; then

	# Run over the gadget's own serial or network link, the steps below cut
	# that link. /config and the services still have to come back.
	trap '' HUP PIPE

	ifdown usb0

	echo ">>>>>>>>>>>>g1 is exist! delete it!"
	# stop adb
	# [ -e /var/run/adbd.pid ] && start-stop-daemon --stop --oknodo --pidfile /var/run/adbd.pid --remove-pidfile --retry 5
	# [ -e /dev/usb-ffs/adb ] && umount /dev/usb-ffs/adb
	# [ -e /dev/usb-ffs ] && rmdir /dev/usb-ffs/adb /dev/usb-ffs
	# systemctl stop serial-getty@ttyGS0.service
	cd /sys/kernel/config/usb_gadget/g1
	echo '' > UDC
	#remove all links
	find . -type l -exec rm -v {} \;
	find configs -name 'strings' -exec rmdir -v {}/0x409 \;
	ls -d configs/* | xargs rmdir -v
	ls -d strings/* | xargs rmdir -v
	# lun.0 goes with its function, any other LUN has to be removed first.
	CONFIG_EXPORTED=""
	if [ -d functions/mass_storage.usb0/lun.1 ]; then
		CONFIG_EXPORTED=1
		rmdir -v functions/mass_storage.usb0/lun.1
	fi
	ls -d functions/* | xargs rmdir -v
	cd ..
	rmdir -v g1
	modprobe -r libcomposite > /dev/null 2>&1 
	# Give /config back and restart what creating the gadget stopped.
	[ -n "$CONFIG_EXPORTED" ] && /etc/init.d/S00config start
	for s in $GADGET_START_SERVICES; do
		# Detached: daemons holding this script's stdout keep an ssh session open.
		[ -x /etc/init.d/$s ] && /etc/init.d/$s start </dev/null >/dev/null 2>&1
	done
	echo ">>>>>>>>>>>>>Delete success, Run script again to create the gadget!!"
	exit 0
fi

# 定义一些变量
HOST_MAC="48:6f:73:74:50:43"
DEVICE_MAC="42:61:64:55:53:42"
MASS_FILE=$(/usr/sbin/auto-dvr.sh  | cut -d: -f 2)

# MASS_FILE=/root/usbdisk.img
# 若指定块设备不存在则创建一个测试用镜像
# if [ ! -e $MASS_FILE ]; then
# 	echo "Create $MASS_FILE format with vfat for Mass Storage......"
# 	dd if=/dev/zero of=$MASS_FILE bs=1M count=8
# 	mkfs.vfat $MASS_FILE
# fi

###############开始创建gadget################
echo ">>>>>>>>>>>>>Starting create gadget......"
cd /sys/kernel/config/usb_gadget/
mkdir g1
# Only now: with g1 in place auto-dvr.sh refuses mounts on its own, so there is
# no gap in which something can mount the partition about to be exported.
rm -f /tmp/gadget
cd g1
echo "0x1d6b" > "idVendor"  # Linux Foundation
echo "0x0104" > "idProduct" # Multifunction Composite Gadget
echo "0x0100" > "bcdDevice" # v1.0.0
echo "0x0200" > "bcdUSB"	# USB 2.0
echo "0xEF" > "bDeviceClass"
echo "0x02" > "bDeviceSubClass"
echo "0x01" > "bDeviceProtocol"

mkdir -p strings/0x409
cat /proc/device-tree/serial-number > strings/0x409/serialnumber
uname -r > strings/0x409/manufacturer
hostname -s > strings/0x409/product

# 创建config1
echo ">>>>>>>>>>>Create config1: ACM + Mass_Storage + NCM ......"
mkdir -p configs/c.1/strings/0x409
echo "0x80" > configs/c.1/bmAttributes
echo 250 > configs/c.1/MaxPower
echo "config1: ACM + Mass_Storage + NCM" > configs/c.1/strings/0x409/configuration

# 创建NCM function
echo ">>>>>>>>Create RNDIS ......"
mkdir -p functions/ncm.usb0
echo "$HOST_MAC" > functions/ncm.usb0/host_addr
echo "$DEVICE_MAC" > functions/ncm.usb0/dev_addr

# 创建串口function
echo ">>>>>>>>Create serial ......"
mkdir -p functions/acm.gs0

# 创建mass_storage function
echo ">>>>>>>>Create Mass_Storage ......"
mkdir -p functions/mass_storage.usb0
echo 1 > functions/mass_storage.usb0/stall
# echo 1 > functions/mass_storage.usb0/lun.0/ro
echo 1 > functions/mass_storage.usb0/lun.0/removable

# FAT cannot be shared: the board has to let go of a partition before the PC
# gets it. A second `gadget` run restarts the services whatever happens below.
stop_services
sync
# Run by hand on a live box, DVR is usually mounted already. Never export it
# while it is: the PC gets no DVR drive rather than a corrupted one.
if grep -q ' /media/dvr ' /proc/mounts && ! umount /media/dvr; then
	echo "gadget: could not unmount /media/dvr, not exporting it" > /dev/kmsg
	MASS_FILE=""
fi
echo $MASS_FILE > functions/mass_storage.usb0/lun.0/file

# Export the CONFIG partition as a second disk, so the toml files can be edited
# from the PC. Only a real partition qualifies: without one /config is a plain
# directory on the overlay (see /etc/init.d/S00config), nothing to export.
CONFIG_DEV=$(awk '$2=="/config"{print $1}' /proc/mounts)
if [ -b "$CONFIG_DEV" ]; then
	echo ">>>>>>>>Create CONFIG LUN ......"
	if /etc/init.d/S00config stop; then
		LUN=functions/mass_storage.usb0/lun.1
		if ! { mkdir -p $LUN && echo 1 > $LUN/removable && echo "$CONFIG_DEV" > $LUN/file; }; then
			echo "gadget: could not export CONFIG, keeping it on the board" > /dev/kmsg
			rmdir $LUN 2>/dev/null
			/etc/init.d/S00config start
		fi
	else
		echo "gadget: could not unmount /config, not exporting it" > /dev/kmsg
	fi
fi

# 创建adb function
# mkdir -p functions/ffs.adb
# mkdir -p /dev/usb-ffs/adb
# mount -o uid=2000,gid=2000 -t functionfs adb /dev/usb-ffs/adb
# export service_adb_tcp_port=5555
# start-stop-daemon --start --oknodo --make-pidfile --pidfile /var/run/adbd.pid --startas /usr/bin/adbd --background
# sleep 2


# 将对应function软连到c.1下面, 即启用该function，MAX 3 functions
ln -s functions/ncm.usb0 configs/c.1/
ln -s functions/acm.gs0 configs/c.1/
ln -s functions/mass_storage.usb0 configs/c.1/
# ln -s functions/ffs.adb configs/c.1/

# 将gadget绑定到USB接
echo ">>>>>>>>>>>Bind config1 to $(ls /sys/class/udc)"
ls /sys/class/udc > UDC
echo "All is done, Run script again to delete the gadget!"

# Start agetty for serial connection
echo 'ttyGS0::respawn:/sbin/agetty ttyGS0' >> /etc/inittab
kill -HUP 1

# start network on usb network
ifup usb0
