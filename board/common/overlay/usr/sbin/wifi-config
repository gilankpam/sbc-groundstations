#!/bin/sh
# wifi-config <wifi.toml> <outdir>
#
# Turn /config/wifi.toml into the files S39wifi runs wlan0 with:
#
#   wifi.env         MODE, AP_ADDRESS, AP_NETMASK, CLIENT_TIMEOUT (sourceable)
#   wpa_ap.conf      wpa_supplicant config for the hotspot (mode=2)
#   dnsmasq.conf     DHCP + catch-all DNS for the hotspot
#   wpa_client.conf  wpa_supplicant config for joining a network (client only)
#
# The AP files are written in every mode because client mode falls back to the
# hotspot when it can't get a lease.
#
# The toml is hand-edited on a PC, so nothing in it is trusted: every value is
# checked, and a bad one is replaced by its default with a warning on stderr
# rather than failing -- the box should always come up with working WiFi.
# Only the subset of TOML the default file uses is understood: [sections],
# key = "string" / 'string' / bare value, and # comments.

export LC_ALL=C

TOML=$1
OUT=$2
[ -n "$OUT" ] || { echo "usage: $0 <wifi.toml> <outdir>" >&2; exit 1; }

mkdir -p "$OUT" || exit 1
PARSED=$OUT/wifi.parsed

# One "section.key<TAB>value" line per assignment.
parse() {
	[ -r "$TOML" ] || return 0
	awk '
	NR == 1 { sub(/^\357\273\277/, "") }  # UTF-8 BOM, as Notepad writes it
	{
		sub(/\r$/, "")                    # CRLF line endings
		sub(/^[ \t]+/, "")
		if ($0 == "" || substr($0, 1, 1) == "#") next
	}
	/^\[/ {
		s = $0
		sub(/^\[[ \t]*/, "", s)
		sub(/[ \t]*\].*$/, "", s)
		section = s
		next
	}
	{
		eq = index($0, "=")
		if (!eq) next
		key = substr($0, 1, eq - 1)
		sub(/[ \t]+$/, "", key)
		rest = substr($0, eq + 1)
		sub(/^[ \t]+/, "", rest)

		q = substr(rest, 1, 1)
		if (q == "\"") {
			# Basic string: \" and \\ are the only escapes worth handling.
			val = ""
			for (i = 2; i <= length(rest); i++) {
				c = substr(rest, i, 1)
				if (c == "\\" && i < length(rest)) {
					i++
					val = val substr(rest, i, 1)
				} else if (c == "\"") {
					break
				} else {
					val = val c
				}
			}
		} else if (q == "\047") {
			# Literal string: no escapes, ends at the next quote.
			val = substr(rest, 2)
			sub(/\047.*$/, "", val)
		} else {
			val = rest
			sub(/[ \t]*#.*$/, "", val)
			sub(/[ \t]+$/, "", val)
		}

		print (section == "" ? "" : section ".") key "\t" val
	}
	' "$TOML"
}

parse >"$PARSED"

# get <section.key>: print the value; fail if the key isn't set at all.
get() {
	awk -F '\t' -v k="$1" '$1 == k { v = $2; f = 1 } END { if (f) print v; exit !f }' "$PARSED"
}

warn() { echo "wifi: $*" >&2; }

is_uint() {
	case $1 in '' | *[!0-9]*) return 1 ;; esac
}

is_ipv4() {
	case $1 in '' | *[!0-9.]* | .* | *. | *..*) return 1 ;; esac
	set -f
	old_ifs=$IFS
	IFS=.
	# shellcheck disable=SC2086
	set -- $1
	IFS=$old_ifs
	set +f
	[ $# -eq 4 ] || return 1
	for o; do
		[ ${#o} -le 3 ] && [ "$o" -le 255 ] || return 1
	done
}

is_passphrase() {
	[ ${#1} -ge 8 ] && [ ${#1} -le 63 ]
}

# opt <section.key> <default> <check> <what>: the key's value if it passes
# <check>, else <default> -- with a warning only if the key was actually set.
opt() {
	if v=$(get "$1"); then
		if $3 "$v"; then
			printf '%s\n' "$v"
			return
		fi
		warn "[${1%%.*}].${1#*.} = \"$v\" is not $4, using \"$2\""
	fi
	printf '%s\n' "$2"
}

is_nonempty() { [ -n "$1" ]; }
is_channel() { is_uint "$1" && [ "$1" -ge 1 ] && [ "$1" -le 13 ]; }
is_timeout() { is_uint "$1" && [ "$1" -ge 1 ]; }
is_mode() { case $1 in ap | client | off) ;; *) return 1 ;; esac; }

mode=$(opt mode ap is_mode 'one of "ap", "client", "off"')

ap_ssid=$(opt ap.ssid "OpenIPC GS" is_nonempty "a network name")
ap_password=$(opt ap.password 12345678 is_passphrase "8 to 63 characters")
ap_channel=$(opt ap.channel 6 is_channel "a 2.4 GHz channel (1-13)")
ap_address=$(opt ap.address 10.18.0.1 is_ipv4 "an IPv4 address")
ap_netmask=$(opt ap.netmask 255.255.255.0 is_ipv4 "an IPv4 netmask")
ap_dhcp_start=$(opt ap.dhcp_start 10.18.0.10 is_ipv4 "an IPv4 address")
ap_dhcp_end=$(opt ap.dhcp_end 10.18.0.100 is_ipv4 "an IPv4 address")

client_timeout=$(opt client.fallback_timeout 30 is_timeout "a number of seconds")

rm -f "$OUT/wpa_client.conf"
if [ "$mode" = client ]; then
	client_ssid=$(get client.ssid)
	client_password=$(get client.password)
	if [ -z "$client_ssid" ]; then
		warn "mode is \"client\" but [client].ssid is empty, running the hotspot instead"
		mode=ap
	elif [ -n "$client_password" ] && ! is_passphrase "$client_password"; then
		warn "[client].password must be 8 to 63 characters (or empty for an open network), running the hotspot instead"
		mode=ap
	else
		{
			echo "network={"
			printf '    ssid="%s"\n' "$client_ssid"
			if [ -n "$client_password" ]; then
				printf '    psk="%s"\n' "$client_password"
			else
				echo "    key_mgmt=NONE"
			fi
			echo "}"
		} >"$OUT/wpa_client.conf"
	fi
fi

# wpa_supplicant takes the ssid/psk as everything between the first and the
# last quote, so a quote inside the value needs no escaping.
{
	echo "network={"
	echo "    mode=2"
	echo "    frequency=$((2407 + 5 * ap_channel))"
	printf '    ssid="%s"\n' "$ap_ssid"
	printf '    psk="%s"\n' "$ap_password"
	echo "}"
} >"$OUT/wpa_ap.conf"

cat >"$OUT/dnsmasq.conf" <<EOF
interface=wlan0
dhcp-range=$ap_dhcp_start,$ap_dhcp_end,$ap_netmask,1h
address=/#/$ap_address
dhcp-option=option:router,$ap_address
dhcp-option=option:dns-server,$ap_address
EOF

# Every value here has been validated, so this is safe to source.
cat >"$OUT/wifi.env" <<EOF
MODE=$mode
AP_ADDRESS=$ap_address
AP_NETMASK=$ap_netmask
CLIENT_TIMEOUT=$client_timeout
EOF

rm -f "$PARSED"
